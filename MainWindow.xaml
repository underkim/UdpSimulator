<Window x:Class="UdpSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UdpSimulator.ViewModels"
        xmlns:conv="clr-namespace:UdpSimulator.Converters"
        Title="UDP Simulator" Height="820" Width="1200"
        Background="#1E1E1E" Foreground="#E0E0E0"
        FontFamily="Consolas" FontSize="13">

    <Window.Resources>
        <conv:DirectionColorConverter x:Key="DirColor"/>
        <conv:BoolNegateConverter     x:Key="NegBool"/>

        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Foreground"  Value="#CCCCCC"/>
            <Setter Property="Padding"     Value="6"/>
            <Setter Property="Margin"      Value="4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background"  Value="#2D2D2D"/>
            <Setter Property="Foreground"  Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding"     Value="4,2"/>
            <Setter Property="CaretBrush"  Value="White"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background"  Value="#2D2D2D"/>
            <Setter Property="Foreground"  Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#555"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background"  Value="#3A3A3A"/>
            <Setter Property="Foreground"  Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#666"/>
            <Setter Property="Padding"     Value="10,4"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="MinWidth"    Value="80"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#505050"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground"        Value="#AAAAAA"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1565C0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GreenBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2E7D32"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#388E3C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RedBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#B71C1C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C62828"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OrangeBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#E65100"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F57C00"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: Connection -->
            <RowDefinition Height="Auto"/>  <!-- 1: Send -->
            <RowDefinition Height="Auto"/>  <!-- 2: Auto-send + Pcap -->
            <RowDefinition Height="Auto"/>  <!-- 3: Templates -->
            <RowDefinition Height="*"/>     <!-- 4: Log + Detail -->
            <RowDefinition Height="Auto"/>  <!-- 5: Status bar -->
        </Grid.RowDefinitions>

        <!-- ── 0: Connection ─────────────────────────────────────────────── -->
        <GroupBox Grid.Row="0" Header="Connection">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="Local IP:"/>
                <TextBox Width="120" Text="{Binding LocalIp}"
                         IsEnabled="{Binding IsConnected, Converter={StaticResource NegBool}}" Margin="0,0,8,0"/>
                <Label Content="Port:"/>
                <TextBox Width="60"  Text="{Binding LocalPort}"
                         IsEnabled="{Binding IsConnected, Converter={StaticResource NegBool}}" Margin="0,0,16,0"/>
                <Label Content="Remote IP:"/>
                <TextBox Width="120" Text="{Binding RemoteIp}"  Margin="0,0,8,0"/>
                <Label Content="Port:"/>
                <TextBox Width="60"  Text="{Binding RemotePort}" Margin="0,0,16,0"/>
                <Label Content="Mode:"/>
                <ComboBox Width="110" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}"
                          IsEnabled="{Binding IsConnected, Converter={StaticResource NegBool}}" Margin="0,0,16,0"/>
                <Button Content="{Binding ConnectLabel}"
                        Command="{Binding ToggleConnectCommand}"
                        Style="{StaticResource AccentBtn}"/>
            </StackPanel>
        </GroupBox>

        <!-- ── 1: Send ───────────────────────────────────────────────────── -->
        <GroupBox Grid.Row="1" Header="Send">
            <StackPanel>
                <!-- Burst count -->
                <DockPanel Margin="0,2">
                    <Label Content="Burst:" Width="50"/>
                    <TextBox Width="50" Text="{Binding BurstCount}" Margin="0,0,8,0"
                             ToolTip="Number of packets to send per click"/>
                    <Label Content="(packets per send)" Foreground="#666"/>
                </DockPanel>
                <!-- Hex send -->
                <DockPanel Margin="0,2">
                    <Label Content="Hex:" Width="50"/>
                    <Button DockPanel.Dock="Right" Content="Send Hex"
                            Command="{Binding SendHexDataCommand}" Style="{StaticResource GreenBtn}" Margin="6,0,0,0"/>
                    <TextBox Text="{Binding SendHex, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
                </DockPanel>
                <!-- Text send -->
                <DockPanel Margin="0,2">
                    <Label Content="Text:" Width="50"/>
                    <Button DockPanel.Dock="Right" Content="Send Text"
                            Command="{Binding SendTextDataCommand}" Style="{StaticResource GreenBtn}" Margin="6,0,0,0"/>
                    <TextBox Text="{Binding SendText, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <!-- File send -->
                <DockPanel Margin="0,2">
                    <Label Content="File:" Width="50"/>
                    <Button DockPanel.Dock="Right" Content="Send File"
                            Command="{Binding SendFileCommand}" Style="{StaticResource GreenBtn}" Margin="4,0,0,0"/>
                    <Button DockPanel.Dock="Right" Content="Browse…"
                            Command="{Binding BrowseSendFileCommand}" Margin="4,0,0,0"/>
                    <TextBox Text="{Binding SendFilePath}" IsReadOnly="True" Background="#1A1A1A"/>
                </DockPanel>
            </StackPanel>
        </GroupBox>

        <!-- ── 2: Auto-send + Pcap ───────────────────────────────────────── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Auto-send">
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <Label Content="Interval (ms):"/>
                    <TextBox Width="60" Text="{Binding AutoIntervalMs}" Margin="0,0,12,0"/>
                    <Label Content="Mode:"/>
                    <ComboBox Width="90" ItemsSource="{Binding PayloadModes}"
                              SelectedItem="{Binding AutoPayloadMode}" Margin="0,0,8,0"/>
                    <Label Content="Counter offset:"/>
                    <TextBox Width="40" Text="{Binding CounterOffset}" Margin="0,0,12,0"/>
                    <Label Content="Payload (hex):"/>
                    <TextBox Width="200" Text="{Binding AutoPayloadHex, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas" Margin="0,0,8,0"/>
                    <Button Content="{Binding AutoSendLabel}"
                            Command="{Binding ToggleAutoSendCommand}"
                            Style="{StaticResource AccentBtn}"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Pcap Capture" MinWidth="340">
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBox Width="140" Text="{Binding PcapPath}" IsReadOnly="True"
                             Background="#1A1A1A" Margin="0,0,4,0"/>
                    <Button Content="Browse…" Command="{Binding BrowsePcapPathCommand}" Margin="0,0,4,0"/>
                    <Button Content="{Binding PcapLabel}"
                            Command="{Binding TogglePcapCommand}"
                            Style="{StaticResource AccentBtn}" Margin="0,0,4,0"/>
                    <Button Content="Export Log"
                            Command="{Binding ExportLogCommand}"
                            Style="{StaticResource AccentBtn}"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- ── 3: Payload Templates ──────────────────────────────────────── -->
        <GroupBox Grid.Row="3" Header="Payload Templates">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="Name:"/>
                <TextBox Width="120" Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,8,0" ToolTip="Template name to save"/>
                <Button Content="Save" Command="{Binding SaveTemplateCommand}"
                        Style="{StaticResource GreenBtn}" Margin="0,0,8,0"/>
                <Label Content="Load:"/>
                <ComboBox Width="140" ItemsSource="{Binding TemplateNames}"
                          SelectedItem="{Binding SelectedTemplate}" Margin="0,0,8,0"/>
                <Button Content="Load →" Command="{Binding LoadTemplateCommand}"
                        Style="{StaticResource AccentBtn}" Margin="0,0,4,0"/>
                <Button Content="Delete" Command="{Binding DeleteTemplateCommand}"
                        Style="{StaticResource RedBtn}"/>
            </StackPanel>
        </GroupBox>

        <!-- ── 4: Packet log + Hex detail ────────────────────────────────── -->
        <Grid Grid.Row="4" Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="390"/>
            </Grid.ColumnDefinitions>

            <!-- Packet list -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock Text="Packet Log" Foreground="#888" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="Clear"
                            Command="{Binding ClearLogCommand}"
                            Style="{StaticResource RedBtn}" Padding="8,2" MinWidth="60"/>
                    <Button DockPanel.Dock="Right" Content="{Binding LoggingLabel}"
                            Command="{Binding ToggleLoggingCommand}"
                            Style="{StaticResource AccentBtn}" Padding="8,2" MinWidth="90" Margin="0,0,6,0"/>
                    <Button DockPanel.Dock="Right" Content="{Binding AutoScrollLabel}"
                            Command="{Binding ToggleAutoScrollCommand}"
                            Style="{StaticResource AccentBtn}" Padding="8,2" MinWidth="90" Margin="0,0,6,0"/>
                    <ComboBox DockPanel.Dock="Right" Width="80"
                              ItemsSource="{Binding LogFilters}"
                              SelectedItem="{Binding LogFilter}"
                              Margin="0,0,6,0" VerticalAlignment="Center"/>
                </DockPanel>
                <ListView x:Name="PacketListView"
                          Grid.Row="1"
                          ItemsSource="{Binding FilteredLog}"
                          SelectedItem="{Binding SelectedPacket}"
                          Background="#252525" BorderBrush="#444"
                          Foreground="#E0E0E0" FontFamily="Consolas"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingPanel.IsVirtualizing="True">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Time"  Width="100"
                                            DisplayMemberBinding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}"/>
                            <GridViewColumn Header="Dir"   Width="36">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Direction}"
                                                   Foreground="{Binding Direction, Converter={StaticResource DirColor}}"
                                                   FontWeight="Bold"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Peer"  Width="160"
                                            DisplayMemberBinding="{Binding Peer}"/>
                            <GridViewColumn Header="Bytes" Width="55"
                                            DisplayMemberBinding="{Binding Size}"/>
                            <GridViewColumn Header="Data (first 16 bytes)" Width="330"
                                            DisplayMemberBinding="{Binding HexPreview}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#333"/>

            <!-- Hex detail panel -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock Text="Hex Detail" Foreground="#888" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="Resend"
                            Command="{Binding ResendPacketCommand}"
                            Style="{StaticResource GreenBtn}" Padding="8,2" MinWidth="70"/>
                    <Button DockPanel.Dock="Right" Content="Copy"
                            Command="{Binding CopyHexCommand}"
                            Style="{StaticResource OrangeBtn}" Padding="8,2" MinWidth="60" Margin="0,0,6,0"/>
                </DockPanel>
                <TextBox Grid.Row="1"
                         Text="{Binding HexDetail, Mode=OneWay}"
                         IsReadOnly="True"
                         FontFamily="Consolas" FontSize="12"
                         Background="#1A1A1A" Foreground="#80CBC4"
                         BorderBrush="#444"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"/>
            </Grid>
        </Grid>

        <!-- ── 5: Status bar ──────────────────────────────────────────────── -->
        <Border Grid.Row="5" Background="#252525" Padding="8,4" Margin="4,4,4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" Foreground="#4CAF50" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="{Binding RttText}"  Foreground="#FFB300" Margin="16,0"/>
                <TextBlock Grid.Column="2" Text="{Binding RateText}" Foreground="#29B6F6" Margin="0,0,16,0"/>
                <TextBlock Grid.Column="3" Text="{Binding StatsText}" Foreground="#888"/>
            </Grid>
        </Border>
    </Grid>
</Window>
